<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- Kendi SQL Server örneğinize göre düzenleyin -->
    <add name="OtelDb"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=YMKotelOtomasyonu;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Yönetici şifresi SHA-256 özeti olarak saklanır. Varsayılan şifre: 123456 (ilk kurulumdan sonra değiştirin) -->
    <add key="YoneticiKullaniciAdi" value="admin" />
    <add key="YoneticiSifreHash" value="8d969eef6ecad3c29a3a629280e686cf0c3f5d5a86aff3ca12020c923adc6c92" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
</configuration>
